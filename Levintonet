<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title>LEVINTONET</title><meta name="viewport" content="width=device-width, initial-scale=1.0"><style>body{font-family:Arial;background:#0f172a;color:white;margin:0;padding:15px}header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}.logo{display:flex;align-items:center;gap:10px}.logo div{background:#22c55e;padding:8px;border-radius:8px;font-weight:bold}h1{font-size:20px;margin:0}.post{background:#1e293b;padding:15px;border-radius:12px;margin:15px 0}button{background:#22c55e;color:black;border:none;padding:8px 14px;border-radius:20px;font-weight:bold;cursor:pointer}input,textarea{width:100%;padding:10px;border-radius:8px;border:none;margin:5px 0;background:#334155;color:white;box-sizing:border-box}.comment{font-size:14px;background:#334155;padding:8px;border-radius:8px;margin:5px 0}footer{text-align:center;margin-top:40px;padding:20px;border-top:1px solid #334155}footer a{color:#22c55e;text-decoration:none;margin:0 10px;font-weight:bold}.tag{background:#15803d;padding:4px 10px;border-radius:20px;font-size:12px;display:inline-block}</style></head><body><header><div class="logo"><div>L</div><h1>LEVINTONET</h1></div><button>Join Now</button></header><h2>What's moving right now</h2><div class="post"><input id="name" placeholder="Your @name"><textarea id="msg" rows="3" placeholder="What's on your mind?"></textarea><button onclick="post()">+ Post</button></div><div id="feed"></div><footer><p><b>Follow us:</b></p><a href="https://tiktok.com" target="_blank">TikTok</a> | <a href="https://instagram.com" target="_blank">Instagram</a> | <a href="https://youtube.com" target="_blank">YouTube</a></footer><script>let posts = JSON.parse(localStorage.getItem('levintonet_posts')||'[]');function render(){document.getElementById('feed').innerHTML = posts.map((p,i)=>`<div class="post"><b>${p.name}</b> <span style="float:right;font-size:12px">${p.time}</span><p>${p.msg}</p><div class="tag">#${p.tag}</div><div style="float:right">${p.sparks} sparks</div><button onclick="spark(${i})">🔥 Spark</button><div><input placeholder="Write a comment and press Enter..." onkeydown="if(event.key==='Enter')comment(${i},this.value);this.value=''">${p.comments.map(c=>`<div class="comment"><b>${c.name}:</b> ${c.text}</div>`).join('')}</div></div>`).join('');}function post(){let name=document.getElementById('name').value;let msg=document.getElementById('msg').value;if(!name||!msg)return alert("Fill both fields");posts.unshift({name,msg,sparks:0,comments:[],time:'now',tag:'general'});localStorage.setItem('levintonet_posts',JSON.stringify(posts));document.getElementById('name').value='';document.getElementById('msg').value='';render();}function spark(i){posts[i].sparks++;localStorage.setItem('levintonet_posts',JSON.stringify(posts));render();}function comment(i,text){if(!text)return;posts[i].comments.push({name:'Guest',text});localStorage.setItem('levintonet_posts',JSON.stringify(posts));render();}render();</script></body></html>
